#include <stdio.h>

int main()
{
    const int L = 3;
    const int C = 3;
    int matriz[L][C];
    int i,j;
    
    for(i=0;i<L;i++){
        for(j=0;j<C;j++){
            if(i==j){
                matriz[i][j]=1;
            }
            else if(j==C-1-i){
                matriz[i][j]=1;
            }
            else{
                matriz[i][j]=0;
            }
            printf("%d\t", matriz[i][j]);
        }
        printf("\n");
        }
    

    return 0;
}
